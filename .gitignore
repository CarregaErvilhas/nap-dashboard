# venv
venv/

# Python
__pycache__/
*.pyc

# Everything fetched from a source or derived by the pipeline lives in data/.
# The repo root keeps only code, docs and the deliverables (dashboard.html,
# dashboard.png, facts.md, errors.md, novidades.md, network-census.json,
# assets/, scripts/, Agents/, Agents-outputs/).
#
# Populate it with:  bash scripts/fetch_tracker.sh && bash scripts/fetch_data.sh
#                    venv/bin/python scripts/nap_etl.py \
#                        data/evChargingInfra_latest.xml data/evActualStatus_latest.xml data
data/*
!data/.gitkeep

# The tracker-derived registry and its ground-truth labels are the deliberate
# exception: they come from an external authority file that CI cannot always
# refetch, so the snapshot is versioned and tracker_meta.json carries its
# synced_at + sha256 (a stale snapshot is reported in errors.md item 13 rather
# than silently trusted). Everything else under data/ stays out of git.
!data/opc_registry_authority.csv
!data/tracker_errors.csv
!data/tracker_meta.json

# Stray exploratory OSM analyses (one-off debris, see scripts/osm_umap.py)
caca_analysis.csv
osm_v21_matched.csv
osm_single_matches.csv
osm_far_from_nap.csv

# Shell junk
.DS_Store
